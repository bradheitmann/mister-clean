{
  "name": "@bradheitmann/mister-clean",
  "version": "6.3.1",
  "description": "Agent skill for paying repository debt and preventing unclean commits.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mister-clean": "bin/mister-clean.js",
    "mister-clean-mcp": "dist/stdio.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "agents/*.yaml",
    "assets/action-manifest.json",
    "assets/closeout-report.json",
    "assets/closure-bundle.json",
    "assets/regression-delta.json",
    "assets/codebase-state-dashboard/index.html",
    "assets/codebase-state-dashboard/dashboard-tokens.css",
    "bin/mister-clean.js",
    "dist/server.*",
    "dist/stdio.*",
    "evals/*.md",
    "evals/*.xml",
    "examples/*.md",
    "references/*.md",
    "templates/*.md",
    "LICENSE",
    "MANIFEST.sha256",
    "README.md",
    "SECURITY.md",
    "SKILL.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradheitmann/mister-clean.git"
  },
  "homepage": "https://bradheitmann.ai/mister-clean/",
  "bugs": {
    "url": "https://github.com/bradheitmann/mister-clean/issues"
  },
  "keywords": [
    "agent-skill",
    "code-quality",
    "handoff",
    "mcp",
    "repository-hygiene",
    "successor-readiness"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:public": "bun src/cli.ts audit public-safety .",
    "build:materials": "bun scripts/generate_materials.mjs",
    "build": "bun run build:materials && tsc --noEmit && tsup && bun run sync:cli && bun run manifest:package",
    "check": "bun run test && bun run pack:check && bun run pack:smoke && bun run audit:public",
    "deploy": "bun run build:materials && wrangler deploy",
    "dev": "bun run build:materials && wrangler dev",
    "manifest:package": "bun src/cli.ts manifest . --package",
    "pack:check": "bun pm pack --dry-run",
    "pack:smoke": "node scripts/verify_packed_cli.mjs",
    "prepack": "bun run build",
    "report:case-study": "bun scripts/render_case_study_report.mjs",
    "report:history": "bun scripts/generate_codebase_history.mjs",
    "sync:cli": "bun scripts/sync_cli.mjs",
    "test": "bun run build && vitest run",
    "types": "wrangler types env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.0.1",
    "tsup": "8.5.0",
    "typescript": "6.0.3",
    "vitest": "4.0.18",
    "wrangler": "4.125.0",
    "yaml": "2.9.0"
  },
  "trustedDependencies": [
    "core-js-pure",
    "esbuild",
    "workerd"
  ],
  "packageManager": "bun@1.4.0"
}
