{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "env.d.ts",
    "customer-tests/**/*.ts",
    "ablations/**/*.ts",
    "scripts/attest_sign.ts",
    "scripts/attest_sign.test.ts",
    "scripts/sync_cli.ts",
    "scripts/verify_package_exports.ts",
    "scripts/build_model_scorecard_interactions.ts",
    "scripts/generate_materials.ts",
    "scripts/generate_codebase_history.ts",
    "scripts/report_snapshot.ts",
    "scripts/render_model_scorecard.ts",
    "scripts/render_case_study_report.ts",
    "scripts/test-tmp-root.ts",
    "scripts/test-tmp-root.test.ts",
    "vitest.config.ts",
    "scripts/prepare_release_archive.ts",
    "scripts/publish_release_archive.ts",
    "scripts/release_archive_contract.ts",
    "scripts/release_capsule.ts",
    "scripts/generate_release_attestation.ts",
    "scripts/verify_packed_cli.ts",
    "scripts/release_path.test.ts"
  ]
}
