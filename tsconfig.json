{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "env.d.ts",
    "customer-tests/**/*.ts",
    "ablations/**/*.ts",
    "scripts/test-tmp-root.ts",
    "scripts/test-tmp-root.test.ts",
    "vitest.config.ts"
  ]
}
