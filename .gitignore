# OS-regenerated ephemera — Finder rewrites .DS_Store into any browsed directory,
# so a source-tree zero is non-terminal. The freeze/build excludes these
# structurally (see references/tool-liveness.md §6); this keeps them out of VCS too.
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.env
.env.*
!.env.example
.dev.vars*
.npmrc
.public-safety.local
.wrangler/
coverage/
dist/
node_modules/
src/generated-materials.ts
*.skill
RELEASE_ATTESTATION.json

# Live case-study projections are local evidence, never package input. The
# generic dashboard and token pack remain versioned beside these ignored files.
assets/codebase-state-dashboard/case-study-okgo.html
assets/codebase-state-dashboard/model-scorecard-okgo.html
assets/codebase-state-dashboard/okgo-case-study-state.json
assets/codebase-state-dashboard/okgo-main-history.json
assets/codebase-state-dashboard/okgo-model-scorecard.json
assets/codebase-state-dashboard/receipts/
