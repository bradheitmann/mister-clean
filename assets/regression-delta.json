              "observed_at": "<ISO-8601 timestamp>"
            },
            {
              "phase": "after",
              "object": "<post-action snapshot or digest>",
              "command_sha256": "<sha256 of exact command string>",
              "detector_sha256": "<sha256 of exact detector string>",
              "result_sha256": "<sha256 of exact comparator output>",
              "result_ref": {
                "path": "comparator-results/<action-id>-after.txt",
                "sha256": "<sha256 of exact comparator output>"
              },
              "finding_fingerprints": [],
              "exit_code": 0,
              "observed_at": "<ISO-8601 timestamp>"
            }
          ]
        }
      ],
      "introduced": 0,
      "paid_before_boundary": 0,
      "open_at_boundary": 0,
