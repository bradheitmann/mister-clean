{
  "record_type": "mister-clean.regression-delta",
  "schema_version": "1.2",
  "policy": "zero_open_run_introduced_debt",
  "baseline_object": "<full starting commit>",
  "closing_object": "<full closing subject commit>",
  "baseline_findings": 0,
  "closing_findings": 0,
  "baseline_paid": 0,
  "baseline_open": 0,
  "newly_discovered_preexisting_paid": 0,
